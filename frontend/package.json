{
  "name": "prt-ot-doc-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:critical": "vitest run --coverage --config vitest.critical.config.ts --run src/__tests__/AppRouterSmoke.test.tsx src/__tests__/SideNav.test.tsx src/__tests__/TopNav.test.tsx src/__tests__/CommandBar.test.tsx src/__tests__/NavMenuProvider.test.tsx src/__tests__/DocumentsPage.test.tsx src/__tests__/TasksPage.test.tsx src/__tests__/PacksPagesStates.test.tsx",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo .vite",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "e2e": "playwright test",
    "e2e:key-scenarios": "playwright test e2e/key-scenarios.spec.ts",
    "e2e:key-scenarios:ps": "powershell -ExecutionPolicy Bypass -File ./scripts/run-e2e-key-scenarios.ps1",
    "e2e:install": "playwright install --with-deps"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-scroll-area": "^1.0.6",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-table": "^8.10.7",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.2.0",
    "i18next": "^23.10.1",
    "immer": "^10.1.1",
    "lucide-react": "^0.336.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-hook-form": "^7.49.2",
    "react-i18next": "^13.5.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^2.15.4",
    "sonner": "^1.4.0",
    "zod": "^3.22.4",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.18",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "rollup": "^4.12.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^0.20.5",
    "vite-tsconfig-paths": "^4.3.1",
    "vitest": "^1.5.0"
  }
}
