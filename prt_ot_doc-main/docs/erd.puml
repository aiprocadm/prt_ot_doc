@startuml
!theme plain
hide circle
skinparam linetype ortho

entity tenant {
  *id: uuid
  slug: text
  name: text
  plan: text
  status: text
  created_at: timestamptz
  updated_at: timestamptz
}

entity "user" as user_tbl {
  *id: uuid
  email: text
  pass_hash: text
  is_active: bool
  created_at: timestamptz
}

entity user_tenant_role {
  *user_id: uuid
  *tenant_id: uuid
  role: text
  features: jsonb
}

entity company {
  *id: uuid
  tenant_id: uuid
  name: text
  inn: text
  kpp: text
  ogrn: text
  legal_address: text
  actual_address: text
  director: text
  phone_numbers: jsonb
  email: text
  logo_file_id: uuid
  stamp_file_id: uuid
}

entity site {
  *id: uuid
  tenant_id: uuid
  company_id: uuid
  name: text
  address: text
}

entity position {
  *id: uuid
  tenant_id: uuid
  company_id: uuid
  name: text
  hazards_ref: text
}

entity person {
  *id: uuid
  tenant_id: uuid
  company_id: uuid
  position_id: uuid
  fio: text
  snils: text
  birth_date: date
  personnel_number: text
  hired_at: date
  passport_json: jsonb
  status: text
}

entity training {
  *id: uuid
  tenant_id: uuid
  person_id: uuid
  program: text
  issued_at: date
  expires_at: date
  cert_no: text
}

entity medical_exam {
  *id: uuid
  tenant_id: uuid
  person_id: uuid
  conclusion: text
  date: date
  expires_at: date
}

entity permit {
  *id: uuid
  tenant_id: uuid
  person_id: uuid
  type: text
  issued_at: date
  expires_at: date
}

entity ppe_item {
  *id: uuid
  tenant_id: uuid
  code: text
  name: text
  category: text
  default_wear_days: int
}

entity ppe_norm {
  *id: uuid
  tenant_id: uuid
  position_id: uuid
  item_code: text
  qty: int
  wear_period_days: int
}

entity ppe_issue {
  *id: uuid
  tenant_id: uuid
  person_id: uuid
  item_code: text
  size: text
  qty: int
  issued_at: timestamptz
  due_replace_at: timestamptz
  status: text
}

entity template {
  *id: uuid
  tenant_id: uuid
  code: text
  name: text
  active_version_id: uuid
}

entity template_version {
  *id: uuid
  tenant_id: uuid
  template_id: uuid
  version: int
  storage_key: text
  placeholders_json: jsonb
  npa_revision: text
  checksum: text
}

entity pack {
  *id: uuid
  tenant_id: uuid
  code: text
  title: text
  description: text
  version: text
}

entity pack_item {
  *id: uuid
  pack_id: uuid
  template_version_id: uuid
  order_no: int
  required: bool
}

entity document_job {
  *id: uuid
  tenant_id: uuid
  preset_id: uuid
  status: text
  params_json: jsonb
  result_zip_key: text
  report_csv_key: text
  correlation_id: text
}

entity document {
  *id: uuid
  tenant_id: uuid
  company_id: uuid
  person_id: uuid
  template_version_id: uuid
  status: text
  storage_key_docx: text
  storage_key_pdf: text
  created_by: uuid
}

entity document_version {
  *id: uuid
  document_id: uuid
  template_version: text
  data_json: jsonb
  file_key: text
  created_at: timestamptz
}

entity replace_map {
  *id: uuid
  tenant_id: uuid
  name: text
  csv_file_key: text
  options_json: jsonb
}

entity checklist {
  *id: uuid
  tenant_id: uuid
  npa_code: text
  title: text
  version: text
}

entity inspection {
  *id: uuid
  tenant_id: uuid
  site_id: uuid
  checklist_id: uuid
  started_at: timestamptz
  finished_at: timestamptz
  status: text
}

entity violation {
  *id: uuid
  tenant_id: uuid
  inspection_id: uuid
  clause_ref: text
  severity: text
  description: text
  photo_file_id: uuid
}

entity corrective_action {
  *id: uuid
  tenant_id: uuid
  violation_id: uuid
  action: text
  due_date: date
  status: text
  assignee_id: uuid
}

entity incident {
  *id: uuid
  tenant_id: uuid
  site_id: uuid
  occurred_at: timestamptz
  severity: text
  description: text
  status: text
}

entity risk_methodology {
  *id: uuid
  tenant_id: uuid
  code: text
  name: text
  spec_json: jsonb
  version: text
}

entity risk {
  *id: uuid
  tenant_id: uuid
  company_id: uuid
  site_id: uuid
  hazard: text
  probability: int
  severity: int
  level: int
  controls: jsonb
  score: numeric
}

entity npa {
  *id: uuid
  code: text
  title: text
  source_url: text
  effective_from: date
  effective_to: date
}

entity npa_binding {
  *id: uuid
  tenant_id: uuid
  when: timestamptz
  user_id: uuid
  action: text
  object_type: text
  object_id: uuid
  details: jsonb
}

entity file_object {
  *id: uuid
  tenant_id: uuid
  sha256: text
  s3_key: text
  size: bigint
  content_type: text
  version_of: uuid
  meta_json: jsonb
}

entity webhook_outbox {
  *id: uuid
  tenant_id: uuid
  event: text
  payload_json: jsonb
  status: text
  retry_count: int
  next_attempt_at: timestamptz
}

entity billing_subscription {
  *id: uuid
  tenant_id: uuid
  plan: text
  status: text
  renew_at: timestamptz
  limits_json: jsonb
  counters_json: jsonb
}

entity feature {
  *id: uuid
  code: text
  title: text
}

entity feature_enablement {
  *id: uuid
  tenant_id: uuid
  feature_id: uuid
  enabled: bool
  config_json: jsonb
}

entity audit_log {
  *id: uuid
  tenant_id: uuid
  actor_id: uuid
  action: text
  entity: text
  entity_id: uuid
  before_json: jsonb
  after_json: jsonb
  ip: text
  ua: text
  trace_id: text
}

user_tbl ||--o{ user_tenant_role : assigns
tenant ||--o{ user_tenant_role : owns
tenant ||--o{ company : owns
company ||--o{ site : operates
company ||--o{ person : employs
position ||--o{ person : covers
position ||--o{ ppe_norm : defines
person ||--o{ training : attends
person ||--o{ medical_exam : undergoes
person ||--o{ permit : holds
person ||--o{ ppe_issue : receives
tenant ||--o{ ppe_item : catalogues
ppe_item ||--o{ ppe_issue : issues
template ||--o{ template_version : versions
template_version ||--o{ pack_item : includes
pack ||--o{ pack_item : items
template_version ||--o{ document : generates
document ||--o{ document_version : revisions
pack ||--o{ document_job : schedules
document_job ||--o{ document : produces
checklist ||--o{ inspection : guides
inspection ||--o{ violation : records
violation ||--o{ corrective_action : mitigates
site ||--o{ incident : reports
company ||--o{ risk : tracks
risk_methodology ||--o{ risk : evaluates
npa ||--o{ npa_binding : references
template_version ||--o{ npa_binding : tagged
tenant ||--o{ file_object : stores
tenant ||--o{ webhook_outbox : dispatches
tenant ||--o{ billing_subscription : subscribes
feature ||--o{ feature_enablement : enables
tenant ||--o{ feature_enablement : toggles
tenant ||--o{ audit_log : logs

@enduml
