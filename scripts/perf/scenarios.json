{
  "dataset_assumptions": {
    "tenant": "demo",
    "seed": "demo tenant bootstrapped with stable templates and search corpus",
    "notes": "Use a clean DB snapshot before each baseline run to keep list/search cardinality stable. For flow probes seed demo template/company/person and a reusable document_version_id for apply-headers."
  },
  "profiles": {
    "pr_smoke": [
      {
        "name": "health",
        "path": "/health",
        "requests": 80,
        "concurrency": 16,
        "expect_status": 200,
        "max_p95_ms": 250,
        "max_p99_ms": 600,
        "min_throughput": 30,
        "max_error_rate": 0.02
      },
      {
        "name": "dashboard",
        "path": "/api/v1/dashboard/summary",
        "requests": 60,
        "concurrency": 12,
        "expect_status": 200,
        "max_p95_ms": 600,
        "max_p99_ms": 1200,
        "min_throughput": 15,
        "max_error_rate": 0.02,
        "tenant": "demo"
      },
      {
        "name": "templates_list",
        "path": "/api/v1/templates",
        "requests": 60,
        "concurrency": 12,
        "expect_status": 200,
        "max_p95_ms": 500,
        "max_p99_ms": 1000,
        "min_throughput": 18,
        "max_error_rate": 0.02,
        "tenant": "demo"
      },
      {
        "name": "search_suggest",
        "path": "/api/v1/search/suggest?q=doc",
        "requests": 60,
        "concurrency": 12,
        "expect_status": 200,
        "max_p95_ms": 450,
        "max_p99_ms": 900,
        "min_throughput": 18,
        "max_error_rate": 0.02,
        "tenant": "demo"
      }
    ],
    "nightly_baseline": [
      {
        "name": "health",
        "path": "/health",
        "requests": 200,
        "concurrency": 20,
        "expect_status": 200,
        "tenant": null
      },
      {
        "name": "dashboard",
        "path": "/api/v1/dashboard/summary",
        "requests": 180,
        "concurrency": 18,
        "expect_status": 200,
        "tenant": "demo"
      },
      {
        "name": "templates_list",
        "path": "/api/v1/templates",
        "requests": 180,
        "concurrency": 18,
        "expect_status": 200,
        "tenant": "demo"
      },
      {
        "name": "search_suggest",
        "path": "/api/v1/search/suggest?q=doc",
        "requests": 180,
        "concurrency": 18,
        "expect_status": 200,
        "tenant": "demo"
      },
      {
        "name": "download_file",
        "path": "/api/v1/files",
        "requests": 120,
        "concurrency": 12,
        "expect_status": 200,
        "tenant": "demo"
      },
      {
        "name": "document_generate_apply_headers",
        "path": "/api/v1/documents/generate",
        "method": "FLOW",
        "requests": 60,
        "concurrency": 6,
        "expect_status": 202,
        "tenant": "demo",
        "flow_steps": [
          {
            "method": "POST",
            "path": "/api/v1/documents/generate",
            "headers": {
              "Idempotency-Key": "{{idempotency_key}}"
            },
            "body": {
              "template_code": "Greeting",
              "template_version": 1,
              "company_id": "demo-company",
              "person_id": "demo-person",
              "data": {
                "name": "Perf {{run_uuid}}"
              }
            },
            "expect_status": 202,
            "capture": {
              "document_job_id": "job_id",
              "document_version_id": "document_version_id"
            }
          },
          {
            "method": "POST",
            "path": "/api/v1/headers/documents/demo-document-version-id/apply-headers",
            "headers": {
              "Idempotency-Key": "{{idempotency_key}}"
            },
            "body": {
              "preset_code": "default",
              "data": {
                "source": "perf-baseline"
              }
            },
            "expect_status": 202
          }
        ]
      },
      {
        "name": "files_upload_flow",
        "path": "/api/v1/files:upload-init",
        "method": "FLOW",
        "requests": 80,
        "concurrency": 8,
        "expect_status": 200,
        "tenant": "demo",
        "flow_steps": [
          {
            "method": "POST",
            "path": "/api/v1/files:upload-init",
            "headers": {
              "Idempotency-Key": "{{idempotency_key}}"
            },
            "body": {
              "filename": "perf-{{run_uuid}}.txt",
              "content_type": "text/plain",
              "size_bytes": 128,
              "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            "expect_status": 200,
            "capture": {
              "file_id": "file_id",
              "version_id": "version_id"
            }
          },
          {
            "method": "POST",
            "path": "/api/v1/files/{{file_id}}:finalize",
            "body": {
              "file_id": "{{file_id}}",
              "version_id": "{{version_id}}"
            },
            "expect_status": 200
          },
          {
            "method": "POST",
            "path": "/api/v1/files/{{file_id}}:download-url",
            "body": {
              "purpose": "download",
              "ttl_seconds": 600
            },
            "expect_status": 200
          }
        ]
      },
      {
        "name": "jobs_status_transitions",
        "path": "/api/v1/jobs",
        "method": "FLOW",
        "requests": 60,
        "concurrency": 6,
        "expect_status": 200,
        "tenant": "demo",
        "flow_steps": [
          {
            "method": "POST",
            "path": "/api/v1/jobs",
            "headers": {
              "Idempotency-Key": "{{idempotency_key}}"
            },
            "body": {
              "template_code": "TMP",
              "template_version": 1,
              "input_ref": {
                "type": "inline",
                "payload": {
                  "name": "Perf {{run_uuid}}"
                }
              }
            },
            "expect_status": 202,
            "capture": {
              "job_id": "job.id"
            }
          },
          {
            "method": "GET",
            "path": "/api/v1/jobs/{{job_id}}",
            "expect_status": 200
          },
          {
            "method": "POST",
            "path": "/api/v1/jobs/{{job_id}}:cancel",
            "expect_status": 200
          },
          {
            "method": "POST",
            "path": "/api/v1/jobs/{{job_id}}:retry",
            "body": {
              "retry_failed_only": true
            },
            "expect_status": 200
          }
        ]
      }
    ]
  }
}
