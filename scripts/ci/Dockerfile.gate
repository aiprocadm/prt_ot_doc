# syntax=docker/dockerfile:1
#
# Образ-раннер для локального гейта качества (REL-1).
#
# Назначение: воспроизвести окружение CI-джобы `backend-tests` БЕЗ GitHub Actions —
# тот же Python 3.12 и те же системные/python-зависимости, что и в `Dockerfile`/CI.
# Локальный хост может иметь другой Python (например 3.14) — поэтому гейт всегда
# гоняется внутри этого образа, а не на хосте.
#
# Сборка кэшируется: пересобирается только при изменении requirements*.txt
# (см. scripts/ci/local_gate.py). Код репозитория НЕ копируется в образ — он
# монтируется bind-mount'ом при запуске, чтобы гейт видел текущее дерево.
ARG PYTHON_VERSION=3.12.6
FROM python:${PYTHON_VERSION}-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

# Системные зависимости, без которых не импортируется app / не идут тесты:
#  - libmagic1      → python-magic (детект MIME при загрузке файлов)
#  - poppler-utils  → работа с PDF
#  - curl           → служебное (healthcheck/диагностика)
#
# build-essential СОЗНАТЕЛЬНО НЕ ставим: все пакеты из requirements*.txt имеют
# manylinux-колёса под CPython 3.12 (asyncpg, pydantic-core, cryptography, lxml,
# greenlet, ruff, mypy …) — компилятор не нужен. Это убирает ~100 МБ самых
# медленных и сетево-хрупких загрузок (именно на gcc-12 падала первая сборка).
#
# LibreOffice тоже НЕ ставим: он тяжёлый (~400 МБ) и нужен лишь тестам
# рендеринга документов. Для PG-гейта (alembic + enum-guards) и подавляющего
# большинства unit-тестов он не требуется (см. docs/stabilization/local-evidence-gate.md).
#
# Acquire::Retries — самовосстановление при обрыве соединения с зеркалом Debian.
RUN set -eux; \
    echo 'Acquire::Retries "8";' > /etc/apt/apt.conf.d/80-retries; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libmagic1 \
        poppler-utils \
        curl; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /srv

# Только манифесты зависимостей → слой ставится из кэша, пока они не изменились.
# --retries/--timeout — устойчивость к медленному/рвущемуся каналу.
COPY requirements.txt requirements-dev.txt /srv/
RUN python -m pip install --upgrade --retries 5 --timeout 60 pip \
    && pip install --retries 5 --timeout 60 -r requirements.txt -r requirements-dev.txt

# Код монтируется при запуске (bind-mount), здесь ничего не копируем.
