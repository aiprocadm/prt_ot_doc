APP_ENV=development
APP_NAME=ptd
BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
SECRET_KEY=change-me
JWT_ISSUER=ptd
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

DATABASE_URL=postgresql+asyncpg://ptd:ptd@postgres:5432/ptd
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ptd
POSTGRES_USER=ptd
POSTGRES_PASSWORD=ptd
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=ptdminio
S3_SECRET_KEY=ptdminiosecret
S3_BUCKET=ptd
S3_REGION=us-east-1
S3_SECURE=false

LO_CONVERT_TIMEOUT=45
LO_WORKERS=2
FONTS_PATH=/usr/share/fonts
LIBREOFFICE_BIN=soffice
PDF_LIBREOFFICE_TIMEOUT_SECONDS=45

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
AV_ENABLED=false

TENANT_HEADER_NAME=X-Tenant
DEFAULT_TENANT_SLUG=demo
TENANT_TEMPLATE_SCHEMA=tenant_template
SHARED_SCHEMA=public

API_PREFIX=/api
API_V1_PREFIX=/api/v1
APP_RUN_MODE=docker
APP_DEBUG=true
APP_TRUSTED_HOSTS=localhost,127.0.0.1
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
STORAGE_BACKEND=s3
S3_BACKEND=minio
ADMIN_BOOTSTRAP=1
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=admin123
ADMIN_TENANT=demo
DEMO_BOOTSTRAP=1
DEMO_TENANT_ID=demo
WORKER_QUEUES=default
PDF_WORKER_QUEUE=pdf
CELERY_EAGER=false
RATE_LIMIT_STORAGE_URI=memory://
ENABLE_METRICS=true
ENABLE_GZIP=true
TRACE_HEADER_NAME=X-Trace-Id
MAX_UPLOAD_SIZE=20971520
FILE_ALLOWED_MIME=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
FILE_ALLOWED_EXTENSIONS=pdf,doc,docx,txt
LOG_JSON=true
