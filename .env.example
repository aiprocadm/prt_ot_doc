# ---------------------------------------------
# Application settings
# ---------------------------------------------
APP_NAME=prt-ot-doc
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
API_V1_PREFIX=/api/v1
APP_TRUSTED_HOSTS=localhost,127.0.0.1
APP_CORS_ORIGINS=http://localhost:5173
DEFAULT_LOCALE=ru-RU
DEFAULT_TIMEZONE=Europe/Moscow
SECRET_KEY=please-change-me

# ---------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=documents
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
DATABASE_ECHO=false
# DATABASE_URL can override the DSN composed from values above
DATABASE_URL=
SHARED_SCHEMA=public
DEFAULT_TENANT_SLUG=public

# ---------------------------------------------
# Object storage (MinIO/S3)
# ---------------------------------------------
S3_BACKEND=minio
S3_ENDPOINT=http://minio:9000
S3_BUCKET=documents
S3_ACCESS_KEY=prt_local_access
S3_SECRET_KEY=prt_local_secret
S3_SECURE=false

# ---------------------------------------------
# Redis broker / Celery
# ---------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/1
WORKER_QUEUES=default
CELERY_CONCURRENCY=2
CELERY_LOGLEVEL=info
PDF_WORKER_QUEUE=pdf
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_MAX_RETRIES=5
CELERY_RETRY_BACKOFF_SECONDS=5
CELERY_RETRY_BACKOFF_MAX_SECONDS=300
OUTBOX_POLL_INTERVAL=5
WEBHOOK_URLS_DOCUMENT_GENERATED=
WEBHOOK_URLS_SIGNED=
WEBHOOK_URLS_EXPORTED=
WEBHOOK_URLS_RISK_ASSESSED=
WEBHOOK_URLS_PPE_ISSUED=
WEBHOOK_URLS_TRAINING_COMPLETED=
WEBHOOK_TIMEOUT_SECONDS=10
OUTBOX_MAX_ATTEMPTS=10

# ---------------------------------------------
# Rate limiting / metrics
# ---------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=redis://redis:6379/2
RATE_LIMIT_LOGIN_PER_IDENTITY=5/minute
RATE_LIMIT_UPLOAD_PER_TENANT=10/minute
ENABLE_METRICS=true
ENABLE_GZIP=true
TRACE_HEADER_NAME=X-Trace-Id

# ---------------------------------------------
# JWT / Auth
# ---------------------------------------------
JWT_ISSUER=prt-ot-doc
JWT_AUDIENCE=prt-ot-doc-clients
JWT_ALG=RS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_D=7
PRIVATE_KEY_PEM=
PUBLIC_KEY_PEM=

# ---------------------------------------------
# File uploads & scanning
# ---------------------------------------------
MAX_UPLOAD_SIZE=20971520
FILE_ALLOWED_MIME=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,image/png,image/jpeg
FILE_ALLOWED_EXTENSIONS=pdf,doc,docx,txt,png,jpg
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30
CLAMAV_QUARANTINE_QUEUE=clamav.quarantine
CLAMAV_SCAN_QUEUE=clamav.scan
CLAMAV_QUEUE_URL=memory://

# ---------------------------------------------
# PDF/LibreOffice
# ---------------------------------------------
LIBREOFFICE_BIN=soffice
PDF_FALLBACK_MODE=auto
PDF_LIBREOFFICE_TIMEOUT_SECONDS=120
PDF_LIBREOFFICE_MAX_ATTEMPTS=4
PDF_LIBREOFFICE_RETRY_BACKOFF_SECONDS=1.0
PDF_LIBREOFFICE_RETRY_BACKOFF_MAX_SECONDS=30.0
PDF_WORKER_CONCURRENCY=2

# ---------------------------------------------
# Logging
# ---------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# ---------------------------------------------
# Frontend build (Vite dev server/proxy)
# ---------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
