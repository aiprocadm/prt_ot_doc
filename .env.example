# Локальная разработка / docker-compose. Для staging/production задайте сильные секреты
# (SECRET_KEY, POSTGRES_PASSWORD, S3_*, JWT-ключи, INBOUND_WEBHOOK_HMAC_SECRET) и не копируйте этот файл как есть.
APP_ENV=development
APP_NAME=ptd
BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# ВАЖНО: задайте уникальный секрет. Не используйте дефолтные/простые значения.
SECRET_KEY=
JWT_ISSUER=ptd
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_D=30

# SEC-65: рантайм ходит в БД НЕПРИВИЛЕГИРОВАННОЙ ролью — PostgreSQL игнорирует
# row-level security для SUPERUSER/BYPASSRLS, и тогда все 264 политики изоляции
# арендаторов не работают. DATABASE_URL = роль приложения, MIGRATION_DATABASE_URL =
# роль-владелец для Alembic (ENABLE/FORCE ROW LEVEL SECURITY — DDL только владельца).
DATABASE_URL=postgresql+asyncpg://ptd_app:CHANGE_ME@postgres:5432/ptd
MIGRATION_DATABASE_URL=postgresql+asyncpg://ptd:ptd@postgres:5432/ptd
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ptd
POSTGRES_USER=ptd
# ВАЖНО: задайте сильный пароль БД в staging/prod.
POSTGRES_PASSWORD=
# Роль приложения: создаётся initdb-хуком infra/postgres/initdb/10-app-role.sh
# на пустом кластере, для существующего — scripts/provision_app_role.py.
APP_DB_USER=ptd_app
APP_DB_PASSWORD=
# Пусто = staging/production падают на старте при привилегированной роли,
# development/test только предупреждают. true/false переопределяет.
RLS_REQUIRE_UNPRIVILEGED_DB_ROLE=

# SEC-67: шифрование секретов at-rest и ротация ключа без простоя.
# APP_SECRET_ENCRYPTION_KEY — одиночный ключ (регистрируется под kid "v1").
# Для ротации: положить оба ключа в KEYS и переключить ACTIVE_KID, затем
# `PYTHONPATH=backend python scripts/rotate_secret_keys.py`, и только потом
# убирать отставной ключ из связки.
APP_SECRET_ENCRYPTION_KEYS=
APP_SECRET_ENCRYPTION_ACTIVE_KID=

# SEC-68: внешний контур (клиентский портал) ограничивается ЖЁСТЧЕ внутреннего.
# Счётчик неудачных попыток отдельный: успешные запросы его не тратят, поэтому
# низкий порог ловит перебор токена, не мешая легитимному клиенту.
# ВАЖНО: на memory:// счётчики процесс-локальны — в проде нужен Redis
# (RATE_LIMIT_STORAGE_URI), иначе порог умножается на число воркеров.
PORTAL_RATE_LIMIT_PER_IP=60/minute
PORTAL_AUTH_FAILURES_PER_IP=10/hour
# Срок жизни magic link и потолок, ниже которого его нельзя поднять.
PORTAL_TOKEN_TTL_HOURS=24
PORTAL_TOKEN_MAX_TTL_HOURS=168

# SEC-64 (разд. 64.2): пороги безопасного вскрытия загруженных офисных архивов
# (DOCX/XLSX — это ZIP с XML). Проверка идёт по оглавлению, без распаковки.
# Абсолютные лимиты — основной рубеж против zip-бомб; отношение сжатия намеренно
# высокое, XML легитимно сжимается в десятки раз.
ARCHIVE_MAX_ENTRIES=2000
ARCHIVE_MAX_UNCOMPRESSED_BYTES=209715200
ARCHIVE_MAX_ENTRY_BYTES=104857600
ARCHIVE_MAX_COMPRESSION_RATIO=500

# SEC-64 (разд. 64.1): заголовки безопасности ставит само приложение — прокси
# меняются, и защита, живущая только в одном из них, отсутствует во всех остальных.
# SECURITY_CSP пустой = строгая политика для JSON-API (default-src 'none').
# HSTS уходит только при APP_ENV=production/staging: за TLS-терминирующим прокси
# приложение видит http, и заголовок из dev-запуска закрепил бы https на localhost.
SECURITY_HEADERS_ENABLED=true
SECURITY_CSP=
SECURITY_HSTS_MAX_AGE=31536000
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_RESULT_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
# ВАЖНО: задайте отдельные ключи доступа к хранилищу.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ptd
S3_REGION=us-east-1
S3_SECURE=false

LO_CONVERT_TIMEOUT=45
LO_WORKERS=2
FONTS_PATH=/usr/share/fonts
LIBREOFFICE_BIN=soffice
PDF_LIBREOFFICE_TIMEOUT_SECONDS=45

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
AV_ENABLED=false

TENANT_HEADER_NAME=X-Tenant
DEFAULT_TENANT_SLUG=demo
TENANT_TEMPLATE_SCHEMA=tenant_template
SHARED_SCHEMA=public

API_PREFIX=/api
API_V1_PREFIX=/api/v1
APP_RUN_MODE=docker
APP_DEBUG=true
APP_TRUSTED_HOSTS=localhost,127.0.0.1
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
STORAGE_BACKEND=s3
S3_BACKEND=minio
# Только для dev: не используйте эти значения в публичных/боевых средах.
ADMIN_BOOTSTRAP=1
ADMIN_EMAIL=admin@example.com
# ВАЖНО: задайте сильный пароль администратора.
ADMIN_PASSWORD=
ADMIN_TENANT=demo
# Управляющий тенант: только его администраторы заводят, приостанавливают и меняют
# лимиты остальных тенантов (раздел «Управление тенантами» в админке).
# Пусто -> используется ADMIN_TENANT.
PLATFORM_TENANT_SLUG=demo
DEMO_BOOTSTRAP=1
DEMO_TENANT_ID=demo
WORKER_QUEUES=default
PDF_WORKER_QUEUE=pdf
CELERY_EAGER=false
RATE_LIMIT_STORAGE_URI=memory://
ENABLE_METRICS=true
# Swagger UI /openapi.json /redoc. В APP_ENV=production документация всегда отключена в коде.
ENABLE_OPENAPI_DOCS=true
ENABLE_GZIP=true
TRACE_HEADER_NAME=X-Trace-Id
MAX_UPLOAD_SIZE=20971520
FILE_ALLOWED_MIME=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
FILE_ALLOWED_EXTENSIONS=pdf,doc,docx,txt
LOG_JSON=true

# If set, POST /api/v1/webhooks/inbound/* requires header X-Inbound-Webhook-Signature (hex HMAC-SHA256 of raw body).
INBOUND_WEBHOOK_HMAC_SECRET=
