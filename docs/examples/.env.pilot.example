# Pilot-ready environment configuration (example)
APP_NAME=prt-ot-doc
APP_ENV=production
APP_DEBUG=false

# Tenant & CORS
DEFAULT_TENANT_SLUG=pilot
APP_TRUSTED_HOSTS=pilot.example.com
APP_CORS_ORIGINS=https://pilot.example.com

# Database
DATABASE_URL=postgresql+asyncpg://prt_user:prt_password@db.example.com:5432/prt_pilot
POSTGRES_HOST=db.example.com
POSTGRES_PORT=5432
POSTGRES_DB=prt_pilot
POSTGRES_USER=prt_user
POSTGRES_PASSWORD=prt_password
DATABASE_ECHO=false

# Object storage
S3_BACKEND=minio
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=prt-pilot-docs
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_SECURE=true
PRESIGN_DOWNLOAD_TTL_SECONDS=900

# Auth
SECRET_KEY=CHANGE_ME
JWT_ISSUER=prt-ot-doc
JWT_AUDIENCE=prt-ot-doc-clients
JWT_ALG=RS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_D=7
PRIVATE_KEY_PEM=CHANGE_ME
PUBLIC_KEY_PEM=CHANGE_ME

# PDF generation
LIBREOFFICE_BIN=/usr/bin/soffice
PDF_FALLBACK_MODE=auto
PDF_LIBREOFFICE_TIMEOUT_SECONDS=120
PDF_LIBREOFFICE_MAX_ATTEMPTS=4
PDF_LIBREOFFICE_RETRY_BACKOFF_SECONDS=1
PDF_LIBREOFFICE_RETRY_BACKOFF_MAX_SECONDS=30
PDF_WORKER_QUEUE=pdf
PDF_WORKER_CONCURRENCY=2
DOC_PIPELINE_ENABLE_QR=false
DOC_PIPELINE_ENABLE_WATERMARK=true
DOC_PIPELINE_WATERMARK_TEXT=CONFIDENTIAL

# Redis / Celery
REDIS_URL=redis://redis.example.com:6379/0
REDIS_RESULT_URL=redis://redis.example.com:6379/1
WORKER_QUEUES=default,pdf
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_MAX_RETRIES=5
CELERY_RETRY_BACKOFF_SECONDS=5
CELERY_RETRY_BACKOFF_MAX_SECONDS=300

# Outbox
OUTBOX_POLL_INTERVAL=5
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BACKOFF_SECONDS=5
OUTBOX_RETRY_BACKOFF_MAX_SECONDS=600

# Webhooks (comma-separated)
WEBHOOK_URLS_DOCUMENT_CREATED=https://webhooks.example.com/prt/document-created
WEBHOOK_URLS_DOCUMENT_GENERATED=https://webhooks.example.com/prt/document-generated
WEBHOOK_URLS_DOCUMENT_SIGNED=https://webhooks.example.com/prt/document-signed
WEBHOOK_URLS_DOCUMENT_EXPORTED=https://webhooks.example.com/prt/document-exported
WEBHOOK_URLS_TRAINING_ASSIGNED=https://webhooks.example.com/prt/training-assigned
WEBHOOK_URLS_TRAINING_COMPLETED=https://webhooks.example.com/prt/training-completed
WEBHOOK_TIMEOUT_SECONDS=10

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=redis://redis.example.com:6379/2
RATE_LIMIT_LOGIN_PER_IDENTITY=5/minute
RATE_LIMIT_UPLOAD_PER_TENANT=10/minute
RATE_LIMIT_GENERATE_PER_TENANT=20/minute

# Integrations
USE_1C_INTEGRATION=false
USE_EDO_INTEGRATION=false
USE_FRDO_INTEGRATION=false
USE_EISOT_INTEGRATION=false

# Payload limits
JSON_MAX=1048576
MAX_UPLOAD_SIZE=20971520
DOCUMENT_PAYLOAD_MAX_BYTES=1048576
DOCUMENT_BATCH_MAX_ROWS=500
IDEMPOTENCY_TTL_DAYS=30
FILE_ALLOWED_MIME=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg,text/plain
FILE_ALLOWED_EXTENSIONS=pdf,doc,docx,png,jpg,jpeg,txt

# Antivirus
CLAMAV_QUEUE_URL=redis://redis.example.com:6379/3
CLAMAV_QUARANTINE_QUEUE=clamav.quarantine
CLAMAV_SCAN_QUEUE=clamav.scan
CLAMAV_HOST=clamav.example.com
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
ENABLE_METRICS=true
ENABLE_GZIP=true
MAX_REQUEST_BODY_BYTES=1048576
REQUEST_TIMEOUT_SECONDS=15
TRACE_HEADER_NAME=X-Trace-Id
DEFAULT_LOCALE=ru-RU
DEFAULT_TIMEZONE=Europe/Moscow
